# The SAME Supabase project as the CRM. URL + anon key ONLY.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this repository.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin the printed QR codes point at (no trailing slash). Must match the CRM's
# NEXT_PUBLIC_SCAN_BASE_URL exactly — the portal renders a preview of the SAME
# code, and a preview that differs from the cover in the client's hand is worse
# than no preview. Defaults to https://cupdom.fr when unset.
NEXT_PUBLIC_SCAN_BASE_URL=https://cupdom.fr
